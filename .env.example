# Copie este archivo como .env. Nunca publique el archivo .env.
DATABASE_URL="postgresql://autolegal:CAMBIE_ESTA_CLAVE@localhost:5432/autolegal_control?schema=public"
POSTGRES_PASSWORD="CAMBIE_ESTA_CLAVE"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="autolegal_session"
SESSION_TTL_HOURS="12"
APP_TIMEZONE="America/Bogota"

# Obligatoria únicamente al ejecutar el seed por primera vez.
ADMIN_INITIAL_PASSWORD="CAMBIE_ESTA_CLAVE_SEGURA"
ADMIN_EMAIL="admin@autolegal.local"

# Integraciones externas desactivadas por defecto.
EXTERNAL_EMAIL_ENABLED="false"
EMAIL_PROVIDER="disabled"
PRIVATE_STORAGE_PROVIDER="disabled"
